{
  "name": "shopify-tapioca",
  "runArgs": ["--name", "shopify-tapioca"],
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=tapioca-bundle,target=/usr/local/bundle,type=volume"
  ],
  "postCreateCommand": "bash bin/setup",
  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp"
      ],
      "settings": {
        // Watchman isn't packaged for Debian trixie. Edits made in the editor still
        // reach Sorbet over LSP; only changes made outside it (e.g. git checkout)
        // need a Sorbet restart to be picked up.
        "sorbet.lspConfigs": [
          {
            "id": "stable",
            "name": "Sorbet",
            "description": "Stable Sorbet release, without Watchman",
            "cwd": "${workspaceFolder}",
            "command": ["bundle", "exec", "srb", "typecheck", "--lsp", "--disable-watchman"]
          }
        ]
      }
    }
  }
}
